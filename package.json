{
  "name": "trace-allocator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./src/index.js",
    "dev": "nodemon --nolazy --inspect=0.0.0.0:9229 --prof ./src/index.js",
    "start:debug": "nodemon --nolazy --inspect-brk=0.0.0.0:9229 --prof ./src/index.js"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "minio": "8.0.1",
    "kafkajs":"^2.2.4",
    "pino": "^9.6.0",
    "tinyduration": "^3.3.0",
    "wretch": "^2.7.0",
    "node-cron": "3.0.3",
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "pino-pretty": "^13.0.0",
    "nodemon":"3.1.9"
  }
}
